__pycache__/
*.py[cod]
*$py.class

# Native build output. install.sh compiles vendor sources in place, so these
# land beside them in libs/ - and a 'git add -A' on a rig that has just run
# the installer will otherwise commit them.
*.so
*.so.*
*.o
*.a
*.dat
*.d
*.jpg
*.con
# Real run configs stay out of the repo, but the worked examples are
# documentation and have to travel with the code.
!flyscan/example_flyscan.con
!examples/*.con

# Local notes to Claude. Design philosophy and standing instructions for this
# checkout - useful to have in the working tree, not something to push.
context.md

# Proprietary vendor SDKs. install.sh asks for these by name and URL when they
# are missing; their licences do not permit this public repository to
# redistribute them, so nothing in here is ever committed.
#   - Tucsen Dhyana camera SDK
libs/vendor/
build/
dist/
*.egg-info/
*.egg
venv/
*.swp
*.swo
*~
